# Copy this file to .env only if you add your own local loader later.
# Never commit a real API key. These sample values select DeepSeek, but the
# variable names are provider-neutral and can target another compatible API.
MINICODER_API_KEY=replace-with-your-own-key
MINICODER_BASE_URL=https://api.deepseek.com
MINICODER_MODEL=deepseek-v4-pro

MINICODER_MAX_STEPS=20
MINICODER_MODEL_TIMEOUT_SECONDS=60
MINICODER_COMMAND_TIMEOUT_SECONDS=30
MINICODER_MAX_TOOL_OUTPUT_CHARS=12000
MINICODER_CONTEXT_BUDGET_CHARS=60000
MINICODER_PLANNING_ENABLED=true
# Opt in only after reviewing the local-storage and extra-request tradeoff.
MINICODER_MEMORY_ENABLED=false
